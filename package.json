{
  "name": "appium-ios-tests",
  "version": "1.0.0",
  "description": "Appium + WebdriverIO (TypeScript) test suite for an iOS app on the Simulator",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "wdio run ./config/ios-wdio.conf.ts",
    "typecheck": "tsc --noEmit",
    "appium": "appium",
    "appium:install-driver": "appium driver install xcuitest",
    "appium:doctor": "appium driver doctor xcuitest",
    "wdioIos": "wdio run config/ios-wdio.conf.ts",
    "wdioIosGHTestRun": "wdio run config/ios-gh-test-run-wdio.conf.ts"
  },
  "keywords": [
    "appium",
    "webdriverio",
    "ios",
    "xcuitest",
    "typescript",
    "e2e"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@wdio/allure-reporter": "^9.28.0",
    "@wdio/appium-service": "^9.12.1",
    "@wdio/cli": "^9.12.1",
    "@wdio/cucumber-framework": "^9.29.1",
    "@wdio/globals": "^9.12.1",
    "@wdio/junit-reporter": "^9.28.0",
    "@wdio/local-runner": "^9.12.1",
    "@wdio/spec-reporter": "^9.12.1",
    "allure-commandline": "^2.42.1",
    "appium": "^2.11.5",
    "appium-xcuitest-driver": "^8.4.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
